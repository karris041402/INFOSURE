# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Secrets and local config
.env
.env.*

# Runtime databases (schema lives in backend/app/schema.sql)
*.db
*.db-journal
*.sqlite3

# Raw scraped content: keep only the README (check each source's terms before sharing)
data/raw/*
!data/raw/README.md

# Generated vector index (rebuild with `py -m backend.app.review index build`)
data/index/

# Generated by training/run.py
training/runs/
data/training/splits/

# Large model files (metadata.json and the rest of models/<version>/ stay tracked)
models/**/*.joblib
models/**/*.pkl
models/**/*.pt
models/**/*.bin
models/**/*.safetensors
models/**/*.onnx

# Extension build
extension/node_modules/
extension/dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
